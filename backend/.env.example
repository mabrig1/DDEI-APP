# Server
# PORT is optional — most hosts inject their own; leave unset to use it.
PORT=5000
NODE_ENV=development
# In production, set this to your deployed frontend's origin instead of localhost.
CLIENT_ORIGIN=http://localhost:3000
# The frontend's public URL — used to build password reset links sent by email.
# Falls back to CLIENT_ORIGIN if unset.
FRONTEND_URL=http://localhost:3000

# MongoDB
# In production, use a managed connection string (e.g. MongoDB Atlas), not localhost.
MONGODB_URI=mongodb://localhost:27017/destiny-skills-bridge

# Auth
# Generate a real value with: openssl rand -hex 32 — never use this placeholder in production.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=4h

# Paystack
# Use your live sk_live_... key in production.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mabrig multi-product promoter commission reporting
# Use the SAME long server-only secret configured on mabrig-academic-assistance.
# Never expose it in frontend JavaScript.
PROMOTER_CONVERSION_SECRET=
PROMOTER_CONVERSION_URL=https://academic.mabrigkorie.org/api/referrals/conversion

# Admin dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=change-this-to-a-bcrypt-hash
ADMIN_RECOVERY_TOKEN_HASH=

# Content API key (optional)
CONTENT_API_KEY=

# ── Appwrite backup backend (optional) ───────────────────────────────────────
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6a686f78003e74fe1826
APPWRITE_DATABASE_ID=dsb-backup
APPWRITE_API_KEY=
APPWRITE_BACKUP_ENABLED=true
APPWRITE_SYNC_INTERVAL_MINUTES=15

# Email notifications (optional)
RESEND_API_KEY=
ADMIN_NOTIFY_EMAIL=

# ── Course Coach agent (optional) ────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

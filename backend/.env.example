# Server
# PORT is optional — most hosts (Render, Railway, Fly.io) inject their own; leave unset to use it.
PORT=5000
NODE_ENV=development
# In production, set this to your deployed frontend's origin instead of localhost.
CLIENT_ORIGIN=http://localhost:3000
# The frontend's public URL — used to build password reset links sent by email.
# Falls back to CLIENT_ORIGIN if unset.
FRONTEND_URL=http://localhost:3000

# MongoDB
# In production, use a managed connection string (e.g. MongoDB Atlas), not localhost.
MONGODB_URI=mongodb://localhost:27017/destiny-skills-bridge

# Auth
# Generate a real value with: openssl rand -hex 32 — never use this placeholder in production.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Paystack
# Use your live sk_live_... key in production.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Currently unused by the server (the payment flow redirects to Paystack's hosted checkout),
# kept here for future client-side/inline Paystack integration.
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin dashboard
# Login used by /admin.html and POST /api/admin/login.
ADMIN_USERNAME=admin
# A bcrypt hash of the admin password — never store the plaintext password here.
# Generate one with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=change-this-to-a-bcrypt-hash

# Content API key (optional)
# Lets an external tool (e.g. an AI agent) create/edit/delete Pages & Posts via
# X-Content-Api-Key header, without needing the full admin login. Scoped only
# to /api/content/admin/* — cannot touch users, payments, or applications.
# Generate one with: openssl rand -hex 32 — leave unset to disable this path.
CONTENT_API_KEY=

# ── Appwrite backup backend (optional) ───────────────────────────────────────
# Mirrors MongoDB into Appwrite Cloud so the platform has a second copy of its
# data, and so the public site can still render (read-only) if this API goes
# down. Leave APPWRITE_API_KEY empty to run with no backup backend at all —
# nothing else changes.
#
# Console: https://cloud.appwrite.io/console/project-fra-6a686f78003e74fe1826
# The console path is project-<region>-<projectId>, so region=fra (Frankfurt)
# and projectId=6a686f78003e74fe1826. That ID is Appwrite-generated — the
# project's display name (destiny-skills-bridge) is NOT accepted by the API.
# Each region has its own API host.
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6a686f78003e74fe1826
APPWRITE_DATABASE_ID=dsb-backup

# Server API key from Appwrite → Overview → Integrations → API keys.
# Scopes needed: databases.read, databases.write, tables.read, tables.write,
# collections.read, collections.write, documents.read, documents.write.
# Secret — never expose this to the browser or commit it.
APPWRITE_API_KEY=

# Set to false to pause mirroring while keeping the credentials in place.
APPWRITE_BACKUP_ENABLED=true
# How often to reconcile MongoDB → Appwrite in the background. 0 disables the
# periodic pass and leaves only live per-write mirroring.
APPWRITE_SYNC_INTERVAL_MINUTES=15

# ── OpenRouter — agentic AI (optional) ──────────────────────────────────────
# Powers the AI Advisor, the Help Assistant and the AI Portfolio Builder. Leave
# OPENROUTER_API_KEY empty and every one of those features falls back to the
# rule-based engines that were always here — the site behaves exactly as before,
# so an unfunded AI account can never take a page down.
#
# Get a key at https://openrouter.ai/keys. Set a hard credit limit on the key
# while you are there: it is the only real spend cap.
OPENROUTER_API_KEY=

# Which model answers. OpenRouter is a single endpoint in front of hundreds of
# models from every major vendor, so this is a string, not a rewrite.
#   openrouter/auto  — OpenRouter picks a suitable model per request (default).
#                      Survives models being renamed or retired.
#   openrouter/free  — routes only to zero-cost models. Slower and less capable,
#                      but the bill is ₦0. Good place to start.
#   a specific slug  — e.g. google/gemini-2.0-flash-001. Browse and copy exact
#                      slugs at https://openrouter.ai/models.
# Slugs ending in ":free" are free but rotate in and out often; prefer
# openrouter/free over pinning one if cost is the priority.
OPENROUTER_MODEL=openrouter/auto

# Comma-separated backups, tried by OpenRouter within the same request if the
# primary is rate limited, down, or over its context length.
OPENROUTER_FALLBACK_MODELS=

# Set to false to pause all AI calls (falling back to the rule-based replies)
# without removing the key — the fastest way to stop spend.
OPENROUTER_ENABLED=true

# Tuning. The defaults are sized for Vercel, whose invocation limit the whole
# agent turn — every tool round included — has to finish inside.
OPENROUTER_MAX_TOKENS=700
OPENROUTER_TEMPERATURE=0.4
OPENROUTER_TIMEOUT_MS=12000
OPENROUTER_BUDGET_MS=15000
OPENROUTER_MAX_TOOL_ROUNDS=4
# Per-user (or per-IP) model calls a minute. Over the limit, callers get the
# rule-based reply instead of an error. Counted per server instance.
OPENROUTER_RATE_LIMIT_PER_MINUTE=12

# ── Daily grants agent ───────────────────────────────────────────────────────
# Results requested from OpenRouter's web-search plugin. Billed per result on
# top of tokens, so only the daily grants agent turns this on — the chat agents
# answer from local tools and never search the web.
OPENROUTER_WEB_RESULTS=5

# Listings the daily agent may research with the model per run. This is the
# spend dial for a job that runs unattended every morning: the deterministic
# half (deadline arithmetic, dead-link checks) is free and always runs.
GRANTS_AGENT_MAX_RESEARCH=6

# Optional attribution shown on OpenRouter's public app leaderboards.
OPENROUTER_SITE_URL=https://ddei.online
OPENROUTER_SITE_NAME=Destiny Skills Bridge

# Email notifications (optional)
# If both are set, a notification email is sent to ADMIN_NOTIFY_EMAIL on every new application.
# Get a key at resend.com. Without a verified sending domain, Resend's sandbox sender
# (onboarding@resend.dev) can only deliver to the email address that owns the Resend account.
# RESEND_API_KEY also gates password reset emails (POST /api/auth/forgot-password) — without
# it, the reset link is logged to the server console instead, so local dev still works.
RESEND_API_KEY=
ADMIN_NOTIFY_EMAIL=

# Server
# PORT is optional — most hosts (Render, Railway, Fly.io) inject their own; leave unset to use it.
PORT=5000
NODE_ENV=development
# In production, set this to your deployed frontend's origin instead of localhost.
CLIENT_ORIGIN=http://localhost:3000

# MongoDB
# In production, use a managed connection string (e.g. MongoDB Atlas), not localhost.
MONGODB_URI=mongodb://localhost:27017/destiny-skills-bridge

# Auth
# Generate a real value with: openssl rand -hex 32 — never use this placeholder in production.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Paystack
# Use your live sk_live_... key in production.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Currently unused by the server (the payment flow redirects to Paystack's hosted checkout),
# kept here for future client-side/inline Paystack integration.
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
